# ─────────────────────────────────────────────────────────────────────────────
# Deadliner — переменные окружения (полный список; дефолты = config.Load).
# Скопируйте в .env и заполните обязательные (пустое значение = дефолт).
#
# ВАЖНО: комментарии в этом файле — ТОЛЬКО отдельными строками.
# Парсеры env-файлов (docker compose env_file, docker run --env-file) НЕ
# считают «#» комментарием после пустого значения: строка
#     WEBHOOK_URL=    # https://example/webhook
# превращается в WEBHOOK_URL="# https://example/webhook" — непустое значение с
# мусором, из-за которого процесс уходит в webhook-режим и падает на setWebhook.
# ─────────────────────────────────────────────────────────────────────────────

# Required — без них процесс не стартует.

# Токен бота от @BotFather.
BOT_TOKEN=

# Строка подключения PostgreSQL. В контейнере (compose) перекрывается на хост
# postgres — см. docker-compose.yml.
DATABASE_URL=postgres://deadliner:deadliner@localhost:5432/deadliner?sslmode=disable

# Bot: приём апдейтов. POLLING_MODE=long_polling (по умолчанию) либо webhook.

# Локальный Bot API сервер (опционально).
BOT_API_BASE=

# Username бота без «@» (из @BotFather). Нужен для Main App direct-link
# (https://t.me/<bot>/app?startapp=…) на кнопке инвайта в чате группы:
# Telegram открывает такую ссылку нативно как Mini App. Пусто — инвайт в чат
# уйдёт текстом без кнопки.
BOT_USERNAME=

# Режим приёма апдейтов: long_polling | webhook.
POLLING_MODE=long_polling

# https://<домен>/webhook — публичный адрес приёма апдейтов.
# Непустое значение тоже включает webhook-режим, и тогда WEBHOOK_URL и
# WEBHOOK_SECRET обязательны оба: без URL бот некуда регистрировать вебхук,
# без секрета Telegram принимал бы подделанные апдейты (fail-closed).
WEBHOOK_URL=

# Значение заголовка X-Telegram-Bot-Api-Secret-Token; обязателен в
# webhook-режиме.
WEBHOOK_SECRET=

# Задел: собственный порт бота. serve всегда слушает HTTP_ADDR.
WEBHOOK_PORT=0

# Исходящих сообщений в секунду на процесс.
TG_RATE_GLOBAL=25

# Сообщений в минуту на один чат.
TG_RATE_PER_CHAT=18

# HTTP: REST API + статика TMA + POST /webhook + /healthz — один порт.
HTTP_ADDR=:8080

# DB

# Размер пула соединений.
DB_POOL_MAX=10

# App

# https://<домен> — базовый URL TMA (Telegram требует https).
APP_PUBLIC_URL=

# TTL сессии в днях (sliding renewal).
SESSION_TTL_DAYS=30

# Максимальный возраст auth_date в initData.
AUTH_DATE_MAX_AGE_HOURS=24

# Таймзона по умолчанию для новых пользователей.
DEFAULT_TZ=Europe/Moscow

# debug | info | warn | error.
LOG_LEVEL=info

# json | text.
LOG_FORMAT=json

# Scheduler (воркер напоминаний).
# FinalizeTimeout (75s) в env не выносится: он связан с внутренней выдержкой
# 429 в нотификаторе и зафиксирован в коде.

# Период цикла воркера.
SCHED_POLL_INTERVAL=10s

# Размер батча за один цикл.
SCHED_BATCH=50

# TTL лока строки напоминания.
SCHED_LOCK_TTL=2m

# Попыток отправки до статуса failed.
SCHED_MAX_ATTEMPTS=5

# Cleanup: автоудаление протухших pending-групп + уборка счётчиков и сессий.

# Период cleanup-джобы.
CLEANUP_INTERVAL=1h

# Limits

# Через сколько дней pending-группа без чата и админа удаляется.
GROUP_PENDING_TTL_DAYS=14

# Лимит создания групп в сутки на пользователя.
LIMIT_GROUP_CREATE_DAY=3

# Лимит создания групп в неделю на пользователя.
LIMIT_GROUP_CREATE_WEEK=5

# Запросов claim-кода в час на чат (и столько же на пользователя).
LIMIT_CLAIM_PER_CHAT_HOUR=3

# Срок жизни claim-кода.
CLAIM_CODE_TTL=10m

# TTL инвайт-кода по умолчанию.
INVITE_DEFAULT_TTL_DAYS=7

# Шаблон слага (плюс валидатор длины и обязательной цифры).
SLUG_REGEX=^[А-ЯA-Z0-9]+(-[А-ЯA-Z0-9]+)*$

# Retention окон rate-limit-счётчиков. Обязан быть БОЛЬШЕ самого длинного окна
# лимита — недельного (168ч, LIMIT_GROUP_CREATE_WEEK): окно floor-ится на своё
# начало, поэтому живая строка недельного счётчика бывает почти 168ч от роду.
# Значение ≤ 168ч — ошибка конфигурации (процесс не стартует).
COUNTER_RETENTION=192h

# Docker Compose (не читается приложением, используется compose-файлом).

# Пользователь, пароль и база PostgreSQL в контейнере postgres.
POSTGRES_USER=deadliner
POSTGRES_PASSWORD=deadliner
POSTGRES_DB=deadliner

# Порт на хосте, который публикует контейнер app.
HTTP_PORT=8080
