# ─────────────────────────────────────────────────────────────────────────────
# Deadliner — переменные окружения (полный список; дефолты = config.Load).
# Скопируйте в .env и заполните обязательные (пустое значение = дефолт).
# ─────────────────────────────────────────────────────────────────────────────

# Required — без них процесс не стартует
BOT_TOKEN=                 # токен от @BotFather
DATABASE_URL=postgres://deadliner:deadliner@localhost:5432/deadliner?sslmode=disable

# Bot: приём апдейтов. POLLING_MODE=long_polling (по умолчанию) либо webhook;
# непустой WEBHOOK_URL тоже включает webhook. В webhook-режиме WEBHOOK_SECRET
# ОБЯЗАТЕЛЕН: без него Telegram принимал бы подделанные апдейты (fail-closed).
BOT_API_BASE=              # локальный Bot API сервер (опц.)
POLLING_MODE=long_polling
WEBHOOK_URL=               # https://<домен>/webhook — публичный адрес приёма апдейтов
WEBHOOK_SECRET=            # X-Telegram-Bot-Api-Secret-Token; обязателен в webhook-режиме
WEBHOOK_PORT=0             # задел: свой порт бота (serve всегда слушает HTTP_ADDR)
TG_RATE_GLOBAL=25          # исходящих сообщений в секунду на процесс
TG_RATE_PER_CHAT=18        # сообщений в минуту на один чат

# HTTP: REST API + статика TMA + POST /webhook + /healthz — один порт
HTTP_ADDR=:8080

# DB
DB_POOL_MAX=10

# App
APP_PUBLIC_URL=            # https://<домен> — базовый URL TMA (Telegram требует https)
SESSION_TTL_DAYS=30
AUTH_DATE_MAX_AGE_HOURS=24
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=info             # debug | info | warn | error
LOG_FORMAT=json            # json | text

# Scheduler (воркер напоминаний). FinalizeTimeout (75s) в env не выносится:
# он связан с внутренней выдержкой 429 в нотификаторе и зафиксирован в коде.
SCHED_POLL_INTERVAL=10s
SCHED_BATCH=50
SCHED_LOCK_TTL=2m
SCHED_MAX_ATTEMPTS=5

# Cleanup: автоудаление протухших pending-групп + уборка счётчиков и сессий
CLEANUP_INTERVAL=1h

# Limits
GROUP_PENDING_TTL_DAYS=14
LIMIT_GROUP_CREATE_DAY=3
LIMIT_GROUP_CREATE_WEEK=5
LIMIT_CLAIM_PER_CHAT_HOUR=3
CLAIM_CODE_TTL=10m
INVITE_DEFAULT_TTL_DAYS=7
SLUG_REGEX=^[А-ЯA-Z0-9]+(-[А-ЯA-Z0-9]+)*$

# Retention окон rate-limit-счётчиков. Обязан быть БОЛЬШЕ самого длинного окна
# лимита — недельного (168ч, LIMIT_GROUP_CREATE_WEEK): окно floor-ится на своё
# начало, поэтому живая строка недельного счётчика бывает почти 168ч от роду.
# Значение ≤ 168ч — ошибка конфигурации (процесс не стартует).
COUNTER_RETENTION=192h

# Docker Compose (не читается приложением, используется compose-файлом)
POSTGRES_USER=deadliner
POSTGRES_PASSWORD=deadliner
POSTGRES_DB=deadliner
HTTP_PORT=8080             # порт на хосте, который публикует контейнер app