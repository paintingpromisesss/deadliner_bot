# Required
BOT_TOKEN=
DATABASE_URL=postgres://deadliner:deadliner@localhost:5432/deadliner?sslmode=disable

# Bot
BOT_API_BASE=
POLLING_MODE=long_polling
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=0
TG_RATE_GLOBAL=25
TG_RATE_PER_CHAT=18

# DB
DB_POOL_MAX=10

# App
APP_PUBLIC_URL=
SESSION_TTL_DAYS=30
AUTH_DATE_MAX_AGE_HOURS=24
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=info
LOG_FORMAT=json

# Scheduler
SCHED_POLL_INTERVAL=10s
SCHED_BATCH=50
SCHED_LOCK_TTL=2m
SCHED_MAX_ATTEMPTS=5

# Cleanup (автоудаление протухших pending-групп + уборка счётчиков/сессий)
CLEANUP_INTERVAL=1h

# Limits
GROUP_PENDING_TTL_DAYS=14
LIMIT_GROUP_CREATE_DAY=3
LIMIT_GROUP_CREATE_WEEK=5
LIMIT_CLAIM_PER_CHAT_HOUR=3
CLAIM_CODE_TTL=10m
INVITE_DEFAULT_TTL_DAYS=7
SLUG_REGEX=^[А-ЯA-Z0-9]+(-[А-ЯA-Z0-9]+)*$

# Retention окон rate-limit-счётчиков (COUNTER_RETENTION). Обязан быть БОЛЬШЕ
# самого длинного окна лимита — недельного (168ч, LIMIT_GROUP_CREATE_WEEK):
# окно floor-ится на своё начало, поэтому живая строка недельного счётчика
# бывает почти 168ч от роду. Значение ≤ 168ч — ошибка конфигурации.
COUNTER_RETENTION=192h
